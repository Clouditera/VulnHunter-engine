{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "node-ext/code-coverage/**/*.ts"
  ]
}
