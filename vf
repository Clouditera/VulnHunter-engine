#!/usr/bin/env bash
# VulnHunter-engine（新架构）TUI 启动器——在目标项目根目录下运行
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "$DIR/.env" ]]; then set -a; source "$DIR/.env"; set +a; fi
export PI_CODING_AGENT_DIR="$DIR"
# 新架构白名单挂载：runner（scan/监控台）+ code-coverage（coverage 查询）+ pi-web-access（联网）
exec pi --no-extensions \
  --extension "$DIR/extensions/runner" \
  --extension "$DIR/extensions/code-coverage" \
  --extension "$DIR/extensions/pi-web-access" \
  "$@"
