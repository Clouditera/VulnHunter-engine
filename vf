#!/usr/bin/env bash
# VulnForge-chat 启动器（decide 主会话）
# 系统提示词 = AGENTS.md（全局身份）+ main-prompt.md（decide 任务）
# 扩展按需加载：--no-extensions 关闭自动发现，显式 -e 挂需要的；
# 主会话不挂 code-coverage-tracker（decide 的阅读不计入 coverage——仅记录 hunt）
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PI_CODING_AGENT_DIR="$DIR"
# decide 阶段身份：output-contract 据此对主会话施加 decide 契约；子会话 frontmatter envs 各自覆盖
export VULNFORGE_STAGE="decide"
exec pi \
  --system-prompt "$DIR/AGENTS.md" \
  --append-system-prompt "$DIR/main-prompt.md" \
  --no-context-files \
  --no-extensions \
  --extension "$DIR/extensions/pi-subagents" \
  --extension "$DIR/extensions/output-contract" \
  --extension "$DIR/extensions/code-coverage" \
  --extension "$DIR/extensions/workspace-diff" \
  --extension "$DIR/extensions/pi-context" \
  --extension "$DIR/extensions/session-archive" \
  --skill "$DIR/skills/threat-modeling" \
  --skill "$DIR/skills/wiki-maintainer" \
  "$@"
