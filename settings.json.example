{
  "_comment": "复制为 settings.json 使用。defaultProvider/defaultModel 指向 models.json 里已配的提供者与模型；subagents 为子代理模型覆盖（agentOverrides 按节点名钉强模型）。详见 README。",
  "defaultProvider": "your-provider-id",
  "defaultModel": "your-model-id",
  "subagents": {
    "defaultModel": "your-provider-id/your-model-id:max",
    "agentOverrides": {
      "poc-verify": { "model": "your-provider-id/your-model-id:max" },
      "ev-assess": { "model": "your-provider-id/your-model-id:max" },
      "exp-build": { "model": "your-provider-id/your-model-id:max" }
    }
  },
  "theme": "dark"
}
