{
  // settings.json — pi 全局默认（JSONC，注释会被 strip）。
  // defaultProvider/defaultModel 要与 models.json 里的 provider 名和模型 id 对应；
  // subagents 块给子代理编排：defaultModel 兜底，agentOverrides 按阶段覆盖（动态阶段可用更强模型）。
  "defaultProvider": "my-provider",
  "defaultModel": "your-model-id",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultModel": "my-provider/your-model-id:high",
    "agentOverrides": {
      "poc-verify": { "model": "my-provider/your-model-id:high" },
      "ev-assess":  { "model": "my-provider/your-model-id:high" },
      "exp-build":  { "model": "my-provider/your-model-id:high" }
    }
  }
}
